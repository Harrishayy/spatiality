# Pydantic AI Gateway (model traffic — Anthropic SDK uses authToken/Bearer, NOT apiKey)
PYDANTIC_GATEWAY_URL=https://gateway-eu.pydantic.dev/proxy/anthropic/
PYDANTIC_GATEWAY_KEY=

# Logfire — same pylf_v... token doubles as Gateway auth
LOGFIRE_TOKEN=

# Logfire READ token — separate token minted in the Logfire UI under
# project settings → Read tokens. Scoped read-only and used by the /agent
# service to power the pipeline drill-down UI (queries spans by scene_id).
# Different from LOGFIRE_TOKEN, which is the write/ingest token.
LOGFIRE_READ_TOKEN=
# Logfire Read API base — region must match the LOGFIRE_TOKEN region. EU
# projects use logfire-eu.pydantic.dev (mirrors the gateway-eu host); US
# projects swap to logfire-us. The host without a region (logfire-api...)
# returns 401 for region-scoped tokens.
LOGFIRE_READ_URL=https://logfire-eu.pydantic.dev/v1/query

# Logfire project URL (browser-visible) — drives the "Open in Logfire ↗"
# deep links in the pipeline drill-down drawer. Take it from your Logfire
# dashboard URL: https://logfire.pydantic.dev/<org>/<project>.
NEXT_PUBLIC_LOGFIRE_PROJECT_URL=

# Set to 0 to disable the runtime "every Anthropic client must use the
# Gateway URL" assertion. Only flip off for local unit tests that mock
# the SDK; production / Modal / agent always leave this on.
PYDANTIC_GATEWAY_REQUIRED=1

# Modal (set after `modal deploy inference/modal_app.py` — endpoint URLs are
# printed at deploy time and visible at modal.com/apps/glasses-twin-inference).
MODAL_INFERENCE_URL=
MODAL_SEGMENTATION_URL=
MODAL_PREPARE_SCENE_URL=
MODAL_PROCESS_VIDEO_URL=
MODAL_GET_MANIFEST_URL=
# Public, browser-visible URL for the Modal get-artifact endpoint (local mode only)
NEXT_PUBLIC_MODAL_GET_ARTIFACT_URL=

# Cloudflare R2 — uploads bucket (raw videos, presigned PUT) +
# artifacts bucket (public, finished splat.ply / annotations.json mirror).
# Create r2-credentials Modal secret with the same five values:
#   modal secret create r2-credentials R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... \
#     R2_SECRET_ACCESS_KEY=... R2_UPLOADS_BUCKET=... R2_ARTIFACTS_BUCKET=...
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOADS_BUCKET=spatiality
R2_ARTIFACTS_BUCKET=spatiality-artifacts
R2_ARTIFACTS_PUBLIC_BASE=
# Browser-visible mirror of the above for direct splat.ply fetches
NEXT_PUBLIC_R2_ARTIFACTS_PUBLIC_BASE=

# Web → agent base URL (Render service URL in prod, http://localhost:8080 in dev)
NEXT_PUBLIC_AGENT_URL=
# r2 (default) or local (skips R2, uses multipart upload + Modal Volume)
NEXT_PUBLIC_DEFAULT_MODE=r2

# Comma-separated origins allowed by the agent's CORS layer
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Where artifacts/ lives in production (Render disk mount)
ARTIFACTS_PATH=/var/data/artifacts

# Inference (set on Modal/Kaggle)
VGGT_LOCAL_WEIGHTS=
THREEDGRUT_ROOT=/opt/3dgrut
INFERENCE_3DGRUT_CMD=

# Segmentation — SAM 3.1 only. Weights live in the gated HF repo and are
# snapshot-downloaded at runtime by segmentation/sam.py. Override SAM3_WEIGHTS
# to skip the HF fetch (point at a pre-staged local file).
SAM3_WEIGHTS=
SAM3_CONFIG=sam3_hiera_l.yaml
SAM3_HF_REPO=facebook/sam3.1
SAM3_SNAPSHOT_DIR=
HF_TOKEN=

# Segmentation — VLM (Claude Haiku via Pydantic AI Gateway)
VLM_MODEL=claude-haiku-4-5
VLM_BATCH_SIZE=5
VLM_TILE_PX=320

# One-time setup hints (not env vars):
#   uv sync                       # install Python deps across all packages
#   uv run modal token set        # auth to Modal before `just modal-deploy`
