# Pydantic AI Gateway (model traffic — Anthropic SDK uses authToken/Bearer, NOT apiKey)
PYDANTIC_GATEWAY_URL=https://gateway-eu.pydantic.dev/proxy/anthropic/
PYDANTIC_GATEWAY_KEY=

# Logfire — same pylf_v... token doubles as Gateway auth
LOGFIRE_TOKEN=

# Modal (set after `modal deploy inference/modal_app.py`)
MODAL_INFERENCE_URL=

# Where artifacts/ lives in production (Render disk mount)
ARTIFACTS_PATH=/var/data/artifacts

# Inference (set on Modal/Kaggle)
VGGT_LOCAL_WEIGHTS=
THREEDGRUT_ROOT=/opt/3dgrut
INFERENCE_3DGRUT_CMD=

# Segmentation — SAM 3.1 (preferred) and SAM 2 fallback
SAM3_WEIGHTS=
SAM3_CONFIG=sam3_hiera_l.yaml
SAM2_WEIGHTS=
SAM2_CONFIG=sam2_hiera_l.yaml

# Segmentation — VLM (Claude Haiku via Pydantic AI Gateway)
VLM_MODEL=claude-haiku-4-5
VLM_BATCH_SIZE=5
VLM_TILE_PX=320

# One-time setup hints (not env vars):
#   uv sync                       # install Python deps across all packages
#   uv run modal token set        # auth to Modal before `just modal-deploy`
